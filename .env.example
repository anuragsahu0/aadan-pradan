# ==============================================================================
# AADAN PRADAN — ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env for local development
#
# IMPORTANT:
# - Aadan Pradan is an internet-based virtual-frequency communication application.
# - It does NOT use physical radio frequencies.
# ==============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- Virtual Frequency & Floor Constraints ---
MAX_USERS_PER_FREQUENCY=40
DEFAULT_FREQUENCY=145.800
MAX_TALK_DURATION_MS=30000

# --- Database (PostgreSQL with Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aadan_pradan_dev?schema=public"

# --- Security & JWT Authentication ---
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-min-32-chars-length"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Mobile Client Configuration ---
EXPO_PUBLIC_API_URL="http://localhost:5001/api"
EXPO_PUBLIC_SOCKET_URL="http://localhost:5001"
EXPO_PUBLIC_DEFAULT_FREQUENCY="145.800"
