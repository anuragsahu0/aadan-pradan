# ==============================================================================
# AADAN PRADAN — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=https://app.aadanpradan.io,https://admin.aadanpradan.io

# Virtual Frequency & Floor Constraints
MAX_USERS_PER_FREQUENCY=40
DEFAULT_FREQUENCY=145.800
MAX_TALK_DURATION_MS=30000

# Database (PostgreSQL with SSL enabled in production)
DATABASE_URL="postgresql://prod_user:production_secure_vault_password@prod-db.internal:5432/aadan_pradan_prod?schema=public&sslmode=require"

# Security & JWT Authentication (Generate using `openssl rand -base64 48`)
JWT_SECRET="production-strong-jwt-secret-generate-using-openssl-rand"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebRTC STUN/TURN Signaling Gateway & SFU
WEBRTC_STUN_URL="stun:stun.l.google.com:19302"
# WEBRTC_TURN_URL="turns:turn.aadanpradan.io:5349"
# WEBRTC_TURN_USERNAME="production_turn_user"
# WEBRTC_TURN_CREDENTIAL="production_turn_credential_secret"

# Mobile Client Configuration (Embedded in Expo production build)
EXPO_PUBLIC_API_URL="https://api.aadanpradan.io/api"
EXPO_PUBLIC_SOCKET_URL="https://api.aadanpradan.io"
EXPO_PUBLIC_DEFAULT_FREQUENCY="145.800"
