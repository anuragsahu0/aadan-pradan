# ==============================================================================
# AADAN PRADAN — STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=staging
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=https://staging-app.aadanpradan.io,https://staging-admin.aadanpradan.io

# Virtual Frequency & Floor Constraints
MAX_USERS_PER_FREQUENCY=40
DEFAULT_FREQUENCY=145.800
MAX_TALK_DURATION_MS=30000

# Database
DATABASE_URL="postgresql://staging_user:staging_secure_password@staging-db.internal:5432/aadan_pradan_staging?schema=public"

# Security & JWT Authentication
JWT_SECRET="staging-jwt-secret-min-32-chars-long-secure-key"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# WebRTC STUN/TURN
WEBRTC_STUN_URL="stun:stun.l.google.com:19302"
# WEBRTC_TURN_URL="turn:turn.staging.aadanpradan.io:3478"
# WEBRTC_TURN_USERNAME="staging_turn_user"
# WEBRTC_TURN_CREDENTIAL="staging_turn_password"

# Mobile Client Configuration
EXPO_PUBLIC_API_URL="https://staging-api.aadanpradan.io/api"
EXPO_PUBLIC_SOCKET_URL="https://staging-api.aadanpradan.io"
EXPO_PUBLIC_DEFAULT_FREQUENCY="145.800"
